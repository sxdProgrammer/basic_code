# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=EX_DB
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# =========================================================================
# SECURITY & JWT CONFIGURATION
# =========================================================================
# A strong secret key used to sign JWTs (at least 32 characters long)
JWT_SECRET=siamgroup_super_secret_jwt_key_for_development_purposes
# JWT Token Lifespan (in seconds, e.g., 3600 = 1 hour)
JWT_ACCESS_EXPIRY=3600

# =========================================================================
# CORS SETTINGS
# =========================================================================
# Comma-separated allowed frontend origins (No trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500,http://localhost:5501,http://localhost
